rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Public can read all files (images displayed on the site)
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && isAdmin()
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 20 * 1024 * 1024) ||
          (request.resource.contentType.matches('video/.*') && request.resource.size < 20 * 1024 * 1024) ||
          (request.resource.contentType == 'application/pdf' && request.resource.size < 20 * 1024 * 1024) ||
          (request.resource.contentType.matches('audio/.*') && request.resource.size < 100 * 1024 * 1024)  // max 100 MB — sermons/services run long
        );
    }

    function isAdmin() {
      return firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
  }
}
